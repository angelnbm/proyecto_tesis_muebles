{
  "name": "tablón-unit-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Pruebas unitarias del proyecto Tablón",
  "scripts": {
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:report": "jest --verbose && start reporte\\resultados.html"
  },
  "devDependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jest": "^29.7.0",
    "jest-html-reporters": "^3.1.7",
    "jsonwebtoken": "^9.0.3",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "reporters": [
      "default",
      [
        "jest-html-reporters",
        {
          "publicPath": "./reporte",
          "filename": "resultados.html",
          "pageTitle": "Resultados Pruebas Unitarias — Amedida",
          "openReport": false,
          "includeFailureMsg": true,
          "includeConsoleLog": true
        }
      ]
    ]
  }
}
